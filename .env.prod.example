# ============================================================
# CRI Assistant - Production Environment Example
# Copier ce fichier vers .env.prod sur le serveur.
# NE JAMAIS commiter .env.prod.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_BIND_IP=127.0.0.1
APP_PORT=8081


# ------------------------------------------------------------
# PostgreSQL
# Utiliser un mot de passe long, aléatoire et URL-safe.
# ------------------------------------------------------------

POSTGRES_DB=cri_assistant
POSTGRES_USER=cri_user
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD


# ------------------------------------------------------------
# Chroma
# ------------------------------------------------------------

CHROMA_COLLECTION=cri_documents


# ------------------------------------------------------------
# Ollama
# ------------------------------------------------------------

OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=bge-m3
# ------------------------------------------------------------
# LLM
# ------------------------------------------------------------

LLM_PROVIDER=deepseek
LLM_FALLBACK_PROVIDER=ollama

DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=60

GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=60


# ------------------------------------------------------------
# Google Authentication
# ------------------------------------------------------------

GOOGLE_CLIENT_ID=CHANGE_ME
