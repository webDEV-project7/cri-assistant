{
  "id": null,
  "uid": "cri-user-activity",
  "title": "CRI Assistant - Supervision des utilisateurs",
  "description": "Tableau de bord de supervision et d'audit du portail CRI Assistant.",
  "tags": [
    "CRI",
    "audit",
    "users",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 6,
  "refresh": "10s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "activity",
        "label": "Activit\u00e9",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "cri-loki"
        },
        "query": "label_values({job=\"cri-backend\",log_type=\"audit\"}, event)",
        "definition": "label_values({job=\"cri-backend\",log_type=\"audit\"}, event)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "user",
        "label": "Utilisateur",
        "type": "textbox",
        "query": ".*",
        "current": {
          "selected": true,
          "text": ".*",
          "value": ".*"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "status",
        "label": "Statut",
        "type": "custom",
        "query": "success,failed,error",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "table",
      "title": "Activit\u00e9 r\u00e9cente des utilisateurs",
      "datasource": {
        "type": "loki",
        "uid": "cri-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"cri-backend\",log_type=\"audit\"} | json | details_user_name != \"\" | line_format `{\"user_name\":\"{{.details_user_name}}\",\"activity\":\"{{.event}}\",\"status\":\"{{.status}}\",\"duration_ms\":{{.duration_ms}},\"endpoint\":\"{{.endpoint}}\"}`",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Heure"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Utilisateur"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 230
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Activit\u00e9"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 210
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Statut"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Dur\u00e9e"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": true,
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "user_name": 1,
              "activity": 2,
              "status": 3,
              "duration_ms": 4,
              "endpoint": 5
            },
            "renameByName": {
              "Time": "Heure",
              "user_name": "Utilisateur",
              "activity": "Activit\u00e9",
              "status": "Statut",
              "duration_ms": "Dur\u00e9e",
              "endpoint": "Endpoint"
            }
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Actions filtr\u00e9es",
      "datasource": {
        "type": "loki",
        "uid": "cri-loki"
