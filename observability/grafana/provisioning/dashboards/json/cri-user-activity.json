      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"cri-backend\",log_type=\"audit\",event=~\"$activity\"}[$__range])) or on() vector(0)",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
